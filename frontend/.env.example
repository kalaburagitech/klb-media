# =============================================================================
# VERCEL — add these in Project Settings → Environment Variables
# Root directory for Vercel deploy: frontend
# =============================================================================

# --- Required: Convex (client) ---
NEXT_PUBLIC_CONVEX_URL=https://silent-ibis-390.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://silent-ibis-390.convex.site
MEDIA_SERVICE_TOKEN=
MEDIA_ADMIN_EMAILS=admin@example.com
MEDIA_APP_BASE_URL=https://klb-media.vercel.app

# --- Required: Cloudflare R2 (server routes /api/r2-file, /api/r2-upload) ---
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET=klbmedia
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# --- Optional: public CDN (only if you deploy Cloudflare Worker) ---
# R2_PUBLIC_BASE_URL=https://your-worker.workers.dev/cdn
# NEXT_PUBLIC_MEDIA_CDN_URL=https://your-worker.workers.dev/cdn
# NEXT_PUBLIC_MEDIA_API_URL=https://your-worker.workers.dev

# =============================================================================
# CONVEX DASHBOARD — set separately at dashboard.convex.dev (NOT in Vercel)
# Deployment: silent-ibis-390
# =============================================================================
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=klbmedia
# R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL=https://YOUR_VERCEL_URL/api/r2-file
# TRANSCODING_ENABLED=false
# CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev
# MEDIA_APP_BASE_URL=https://klb-media.vercel.app
# TRANSCODER_URL=          (only if transcoding enabled)
# TRANSCODER_SECRET=       (only if transcoding enabled)
