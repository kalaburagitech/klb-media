# Cloudflare R2 (copy values from r2credentials.md — never commit real secrets)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET=klbmedia
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://your-worker.workers.dev/cdn

# Convex
# CONVEX_DEPLOYMENT=dev:silent-ibis-390
# NEXT_PUBLIC_CONVEX_URL=https://silent-ibis-390.convex.cloud
# NEXT_PUBLIC_CONVEX_SITE_URL=https://silent-ibis-390.convex.site
# CONVEX_SITE_URL=https://silent-ibis-390.convex.site

# Storage mode (set in Convex: npx convex env set TRANSCODING_ENABLED false)
# false = originals only — best for 10 GB free tier (images, PDF, audio, video)
# true  = FFmpeg transcoding for video only
TRANSCODING_ENABLED=false

# Transcoder — only when TRANSCODING_ENABLED=true
# TRANSCODER_URL=http://localhost:8787
# TRANSCODER_SECRET=change-me-in-production

# Next.js public URLs
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_MEDIA_API_URL=
NEXT_PUBLIC_MEDIA_CDN_URL=
